<?php

namespace $NAMESPACE$;

use Elemind\FilamentECharts\Widgets\EChartWidget;

class $CLASS_NAME$ extends EChartWidget
{
    /**
     * Chart Id
     */
    protected static ?string $chartId = '$CHART_ID$';

    /**
     * Widget Title
     *
     * @var string|null
     */
    protected static ?string $heading = '$CLASS_NAME$';

    /**
     * Chart options (series, labels, types, size, animations...)
     * https://echarts.apache.org/en/option.html
     *
     * @return array<array-key, mixed>
     */
    protected function getOptions(): array
    {
        return [
            "series" => [
                [
                    "type" => "gauge",
                    "axisLine" => [
                        "lineStyle" => [
                            "width" => 10,
                            "color" => [
                                [0.3, "#67e0e3"],
                                [0.7, "#37a2da"],
                                [1, "#fd666d"],
                            ],
                        ],
                    ],
                    "pointer" => [
                        "itemStyle" => [
                            "color" => "auto",
                        ],
                    ],
                    "axisTick" => [
                        "distance" => -30,
                        "length" => 8,
                        "lineStyle" => [
                            "color" => "#fff",
                            "width" => 2,
                        ],
                    ],
                    "splitLine" => [
                        "distance" => -30,
                        "length" => 30,
                        "lineStyle" => [
                            "color" => "#fff",
                            "width" => 4,
                        ],
                    ],
                    "axisLabel" => [
                        "color" => "inherit",
                        "distance" => 20,
                        "fontSize" => 10,
                    ],
                    "detail" => [
                        "valueAnimation" => false,
                        "formatter" => "{value} km/h",
                        "color" => "inherit",
                        "fontSize" => 15,
                    ],
                    "data" => [
                        [
                            "value" => 70,
                        ],
                    ],
                ],
            ],
        ];
    }
}
